# Cloud Build needs only the container recipe, locked dependency metadata, and app.
# Start closed and explicitly admit runtime build inputs.
**
!.dockerignore
!Dockerfile
!cloudbuild.yaml
!pyproject.toml
!uv.lock
!src/
!src/**

# Generated Python files and source-adjacent documentation are not build inputs.
src/**/__pycache__/
src/**/*.py[cod]
src/**/*.md
